<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="_precision_adj">
    <property name="lower">0</property>
    <property name="upper">6</property>
    <property name="value">2</property>
    <property name="step-increment">1</property>
    <property name="page-increment">2</property>
  </object>
  <object class="GtkAdjustment" id="_offset_adj">
    <property name="lower">-90000</property>
    <property name="upper">90000</property>
    <property name="value">5</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkStringList" id="text_model">
    <items>
      <item translatable="yes">Above</item>
      <item translatable="yes">Inline</item>
      <item translatable="yes">Below</item>
    </items>
  </object>

  <object class="GtkBox" id="dimension-toolbar">
    <property name="halign">start</property>
    <property name="valign">center</property>
    <property name="hexpand">True</property>
    <child>
      <object class="GtkToggleButton" id="mode_auto">
        <property name="valign">center</property>
        <property name="focusable">True</property>
        <property name="focus-on-click">False</property>
        <property name="receives-default">True</property>
        <property name="group">dimensionmode</property>
        <property name="has-frame">True</property>
        <property name="label" translatable="yes">Auto</property>
        <property name="tooltip-text" translatable="yes">Measure horizontally or vertically, whichever the drag favours</property>
      </object>
    </child>
    <child>
      <object class="GtkToggleButton" id="mode_parallel">
        <property name="valign">center</property>
        <property name="focusable">True</property>
        <property name="focus-on-click">False</property>
        <property name="receives-default">True</property>
        <property name="group">dimensionmode</property>
        <property name="has-frame">True</property>
        <property name="label" translatable="yes">Parallel</property>
        <property name="tooltip-text" translatable="yes">Measure along the line through the two points; hold Shift to snap to 15 degree steps</property>
      </object>
    </child>
    <child>
      <object class="GtkToggleButton" id="mode_angular">
        <property name="valign">center</property>
        <property name="focusable">True</property>
        <property name="focus-on-click">False</property>
        <property name="receives-default">True</property>
        <property name="group">dimensionmode</property>
        <property name="has-frame">True</property>
        <property name="label" translatable="yes">Angular</property>
        <property name="tooltip-text" translatable="yes">Click the vertex, then two points; move to set the arc radius</property>
      </object>
    </child>
    <child>
      <object class="GtkToggleButton" id="mode_segment">
        <property name="valign">center</property>
        <property name="focusable">True</property>
        <property name="focus-on-click">False</property>
        <property name="receives-default">True</property>
        <property name="group">dimensionmode</property>
        <property name="has-frame">True</property>
        <property name="label" translatable="yes">Segment</property>
        <property name="tooltip-text" translatable="yes">Click a path segment to measure its chord</property>
      </object>
    </child>
    <child>
      <object class="GtkSeparator"/>
    </child>
    <child>
      <object class="GtkBox" id="precision_box">
        <property name="tooltip-text" translatable="yes">Digits after the decimal point of the dimension label</property>
        <child>
          <object class="GtkLabel">
            <property name="margin-start">5</property>
            <property name="label" translatable="yes">Precision</property>
          </object>
        </child>
        <child>
          <object class="gtkmm__CustomObject_InkSpinButton" id="_precision_item">
            <property name="focusable">True</property>
            <property name="adjustment">_precision_adj</property>
            <property name="climb-rate">1</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="offset_box">
        <property name="tooltip-text" translatable="yes">Distance of the dimension line from the measured points, in mm; arc radius for angular dimensions</property>
        <child>
          <object class="GtkLabel">
            <property name="margin-start">5</property>
            <property name="label" translatable="yes">Offset</property>
          </object>
        </child>
        <child>
          <object class="gtkmm__CustomObject_InkSpinButton" id="_offset_item">
            <property name="focusable">True</property>
            <property name="adjustment">_offset_adj</property>
            <property name="climb-rate">0.1</property>
            <property name="digits">2</property>
            <property name="unit" translatable="no">mm</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="unit_menu_box">
        <child>
          <object class="GtkLabel">
            <property name="margin-start">5</property>
            <property name="label" translatable="yes">Units</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="text_box">
        <property name="tooltip-text" translatable="yes">Where the label sits relative to the dimension line</property>
        <child>
          <object class="GtkLabel">
            <property name="margin-start">5</property>
            <property name="label" translatable="yes">Label</property>
          </object>
        </child>
        <child>
          <object class="GtkDropDown" id="text_combo">
            <property name="model">text_model</property>
            <property name="selected">0</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator"/>
    </child>
    <child>
      <object class="GtkToggleButton" id="show_units_btn">
        <property name="valign">center</property>
        <property name="focusable">True</property>
        <property name="focus-on-click">False</property>
        <property name="receives-default">True</property>
        <property name="has-frame">True</property>
        <property name="label" translatable="yes">Show units</property>
        <property name="tooltip-text" translatable="yes">Append the unit to the dimension value</property>
      </object>
    </child>
    <style>
      <class name="inkscape-toolbar"/>
    </style>
  </object>
</interface>
