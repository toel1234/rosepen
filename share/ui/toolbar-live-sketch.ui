<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="_smoothing_adj">
    <property name="lower">0</property>
    <property name="upper">100</property>
    <property name="value">50</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>

  <object class="GtkBox" id="live-sketch-toolbar">
    <property name="halign">start</property>
    <property name="valign">center</property>
    <property name="hexpand">True</property>
    <child>
      <object class="GtkBox" id="smoothing_box">
        <property name="tooltip-text" translatable="yes">How much the hand motion is smoothed into curves while drawing; 0 keeps the raw trail as straight segments</property>
        <child>
          <object class="GtkLabel">
            <property name="margin-start">5</property>
            <property name="label" translatable="yes">Smoothing</property>
          </object>
        </child>
        <child>
          <object class="gtkmm__CustomObject_InkSpinButton" id="smoothing_item">
            <property name="focusable">True</property>
            <property name="adjustment">_smoothing_adj</property>
            <property name="climb-rate">1</property>
            <property name="digits">0</property>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="inkscape-toolbar"/>
    </style>
  </object>
</interface>
